# Local development only. Replace this placeholder with a random URL-safe password.
POSTGRES_DB=llm_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+asyncpg://gateway:replace-with-local-password@postgres:5432/llm_gateway
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen2.5:1.5b
PROVIDER_TIMEOUT_SECONDS=120
DEFAULT_PROVIDER=ollama
# Admin-only bearer credential for creating client keys and reading aggregate metrics.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
DEFAULT_MAX_OUTPUT_TOKENS=512
MAX_OUTPUT_TOKENS=4096
BUDGET_INPUT_TOKEN_PADDING=256
# Responses and embeddings persist in Postgres; cross-key sharing is opt-in.
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
CACHE_SHARE_ACROSS_KEYS=false
# No external provider is enabled by default. The URL includes the /v1 prefix.
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Hypothetical prices in USD per 1,000 tokens. Local inference defaults to zero.
INPUT_COST_PER_1K=0
OUTPUT_COST_PER_1K=0
